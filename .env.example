# Gemini key used by the tutor backend route.
GEMINI_API_KEY=

# Optional override for the tutor model. Defaults to Gemini 3.1 Flash-Lite Preview.
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Optional timeout override in milliseconds for the tutor backend route.
GEMINI_TIMEOUT_MS=12000

# Gate for the results tutor UI.
VITE_ENABLE_RESULTS_TUTOR=false
